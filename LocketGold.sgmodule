#!name= 4in1 by Dtrung (Locket Gold Fixed)
#!desc= By Dinh Trung - Mở khóa Locket Gold, Spotify, Youtube & SoundCloud
#!author= nguồn liên hệ 0915693917
#!moduleUrl=https://raw.githubusercontent.com/dinhtrung1407/locketgold/refs/heads/main/LocketGold.sgmodule
#!howtouse= NDT

[Header Rewrite]
^https?://://revenuecat.com(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://://revenuecat.com(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Url Rewrite]
# Chặn quảng cáo Google Video
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200

# YouTube Ads
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

# General Video Ad request
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Script]
#Sub-Store
Sub-Store Core=type=http-request,pattern=^https?:\/\/sub\.store\/((download)|api\/(preview|sync|(utils\/node-info))),script-path=https://github.com
Sub-Store Simple=type=http-request,pattern=^https?:\/\/sub\.store,script-path=https://github.com
Sub-Store Sync=type=cron,cronexp=0 0 * * *,wake-system=1,timeout=120,script-path=https://github.com

#Youtube Premium
youtube.request = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player|reel\/reel_watch_sequence|get_watch),requires-body=1,max-size=-1,binary-body-mode=1,engine=jsc,script-path=https://githubusercontent.com
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,engine={{{script}}},script-path=https://githubusercontent.com,argument="{"lyricLang":"vi","captionLang":"vi","blockUpload":true,"blockImmersive":true,"debug":false}"

#SoundCloudGo+
SoundCloudGo+=type=http-response,pattern=https://soundcloud.com

# ===== Spotify iOS15 =====
spotify-json = type=http-request,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(artistview\/v1\/artist|album-entity-view\/v2\/album)\/,requires-body=0,script-path=https://githubusercontent.com
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)$,requires-body=1,binary-body-mode=1,max-size=0,script-path=https://githubusercontent.com

# RevenueCat Mở khóa Premium các app cơ bản
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://githubusercontent.com, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://githubusercontent.com, timeout=60

# Locket Gold Firebase Config & Gói tin ảnh Filter
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://githubusercontent.com, requires-body=true, max-size=-1, timeout=60
locket_filter = type=http-request, pattern=^https:\/\/api\.locketcamera\.com\/generateFilteredImage, script-path=https://githubusercontent.com, requires-body=true, timeout=60

[MITM]
hostname = %APPEND%, ://revenuecat.com, ://googleapis.com, ://locketcamera.com, *.googlevideo.com, ://googleapis.com, ://youtube.com, ://youtube.com, -redirector*.googlevideo.com, sub.store, ://soundcloud.com, ://spotify.com, *://spotify.com
